# Worked example: Dataset:1 from Chalmers staging to SciLifeLab production.
# Usage: cp configs/staging-to-prod.env.example configs/staging-to-prod.env
#        scripts/transfer.sh -c configs/staging-to-prod.env

SRC=omero-staging.c3se.chalmers.se
DST=omero.scilifelab.se
SRC_USER=gokhozsa
SRC_PASSWORD=                 # optional; if empty, omero login prompts interactively
DST_USER=gokhozsa
DST_PASSWORD=                 # optional; if empty, omero login prompts interactively
GROUP=omero_test_20
OBJ=Dataset:1
ARCHIVE=~/omero-transfers/dataset1.zip
MERGE=false
