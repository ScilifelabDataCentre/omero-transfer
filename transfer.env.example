# Transfer variables. Copy to transfer.env (or configs/<name>.env) and replace every <placeholder>.
# Any variable can also be overridden from the command line, e.g. OBJ=Dataset:4 scripts/transfer.sh

SRC=<source-omero-server>     # hostname you pack from, e.g. omero-test.example.org
DST=<target-omero-server>     # hostname you unpack into, e.g. omero.example.org
SRC_USER=<source-username>    # OMERO login on the source server
SRC_PASSWORD=                 # optional; if empty, omero login prompts interactively
DST_USER=<target-username>    # OMERO login on the target server
DST_PASSWORD=                 # optional; if empty, omero login prompts interactively
GROUP=<your-group>            # OMERO group that owns the data, must exist on both servers
OBJ=Image:19                  # Image:<id>, Dataset:<id>, Project:<id>, Plate:<id>, Screen:<id>; ranges (Image:19-25) and lists (Dataset:1,4,7) work too
ARCHIVE=~/omero-transfers/transfer.zip   # .zip compresses, .tar makes a tarball, no extension writes a directory
MERGE=false                   # true = add into an existing Project/Dataset with the same name on the target

# Only needed when the group name differs between the two servers (both default to GROUP)
# SRC_GROUP=
# DST_GROUP=

# OMERO port, used by the reachability check
# PORT=4064
